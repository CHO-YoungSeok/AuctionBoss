# 복사해서 .env로 쓴다(cp .env.example .env). .env는 git이 추적하지 않는다.
# 아래 값은 개발용 예시이며 실제 비밀이 아니다. 운영에서는 반드시 바꿀 것.

# DB_NAME·DB_USER·DB_PASSWORD와 MYSQL_ROOT_PASSWORD는 운영 구성(docker-compose.yml)에서 필수다(`${VAR:?}`).
# 하나라도 없으면 `docker compose config`가 변수 이름을 알리며 실패하고 어떤 서비스도 시작하지 않는다.
# ANTHROPIC_API_KEY(선택)는 분석 워커용이며 없어도 구성은 해석된다.

# MySQL 컨테이너 root 비밀번호 (docker compose의 mysql 서비스)
MYSQL_ROOT_PASSWORD=change-me-root

# Spring 백엔드 접속 정보. compose의 mysql 서비스가 같은 값으로 DB/사용자를 만든다.
# compose 안의 backend 컨테이너는 DB_HOST/DB_PORT를 mysql:3306으로 덮어쓴다.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=auctionboss
DB_USER=auctionboss
DB_PASSWORD=change-me-app

# compose mysql의 호스트 공개 포트(기본 3307). IDE/bootRun에서 접속할 때 DB_PORT와 맞춘다.
MYSQL_HOST_PORT=3307

# 분석 워커(API 모드)용 키. 없으면 비워 둔다(구성은 그대로 동작, 빈 키는 CLI 모드).
# ANTHROPIC_API_KEY=
